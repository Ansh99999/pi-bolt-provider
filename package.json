{
  "name": "pi-bolt-provider",
  "version": "0.2.0",
  "description": "A small, on-demand provider setup wizard for Pi and Pi-Bolt.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-bolt",
    "pi-extension",
    "provider"
  ],
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ansh99999/pi-bolt-provider.git"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
